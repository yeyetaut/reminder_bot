# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── Anthropic (Claude AI) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Google (Gmail + Google Calendar) ──────────────────────────────────────────
# Download credentials.json from Google Cloud Console and place it in project root
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ── LMS iCal Feeds ────────────────────────────────────────────────────────────
# Canvas: Account → Calendar → "Calendar Feed" → copy URL
CANVAS_ICAL_URL=https://canvas.instructure.com/feeds/calendars/user_xxx.ics

# ── Scheduler timezone ────────────────────────────────────────────────────────
TIMEZONE=America/New_York

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///reminder_bot.db
